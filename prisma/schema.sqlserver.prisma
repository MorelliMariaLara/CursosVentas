generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQL Server Express: LARA-NB\SQLEXPRESS02 / Cursosventas
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique @db.NVarChar(191)
  passwordHash   String           @db.NVarChar(191)
  name           String           @db.NVarChar(191)
  role           String           @default("STUDENT") @db.NVarChar(50)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  examAttempts   ExamAttempt[]
  certificates   Certificate[]
  payments       Payment[]
}

model Course {
  id               String         @id @default(cuid())
  slug             String         @unique @db.NVarChar(191)
  title            String         @db.NVarChar(191)
  shortDescription String         @db.NVarChar(1000)
  description      String         @db.NVarChar(Max)
  price            Float
  currency         String         @default("ARS") @db.NVarChar(10)
  thumbnailPath    String?        @db.NVarChar(1000)
  published        Boolean        @default(false)
  passingScore     Int            @default(70)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  modules          Module[]
  enrollments      Enrollment[]
  exam             Exam?
  certificates     Certificate[]
  payments         Payment[]
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String   @db.NVarChar(191)
  sortOrder Int      @default(0)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([courseId])
}

model Lesson {
  id          String           @id @default(cuid())
  moduleId    String
  title       String           @db.NVarChar(191)
  description String?          @db.NVarChar(Max)
  sortOrder   Int              @default(0)
  durationSec Int              @default(0)
  videoPath   String?          @db.NVarChar(1000)
  videoMime   String?          @db.NVarChar(100)
  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]

  @@index([moduleId])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  status      String    @default("PENDING") @db.NVarChar(50)
  purchasedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments    Payment[]

  @@unique([userId, courseId])
  @@index([courseId])
}

model Payment {
  id                  String      @id @default(cuid())
  userId              String
  courseId            String
  enrollmentId        String?
  amount              Float
  currency            String      @default("ARS") @db.NVarChar(10)
  status              String      @default("PENDING") @db.NVarChar(50)
  mpPreferenceId      String?     @db.NVarChar(191)
  mpPaymentId         String?     @db.NVarChar(191)
  mpExternalReference String?     @unique @db.NVarChar(191)
  rawPayload          String?     @db.NVarChar(Max)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course              Course      @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollment          Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  watchedSec  Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Exam {
  id          String         @id @default(cuid())
  courseId    String         @unique
  title       String         @db.NVarChar(191)
  description String?        @db.NVarChar(Max)
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions   ExamQuestion[]
  attempts    ExamAttempt[]
}

model ExamQuestion {
  id            String @id @default(cuid())
  examId        String
  prompt        String @db.NVarChar(Max)
  sortOrder     Int    @default(0)
  optionsJson   String @db.NVarChar(Max)
  correctOption Int
  exam          Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

model ExamAttempt {
  id          String   @id @default(cuid())
  userId      String
  examId      String
  score       Int
  passed      Boolean
  answersJson String   @db.NVarChar(Max)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([userId, examId])
}

model Certificate {
  id          String   @id @default(cuid())
  code        String   @unique @db.NVarChar(191)
  userId      String
  courseId    String
  issuedAt    DateTime @default(now())
  pdfPath     String?  @db.NVarChar(1000)
  studentName String   @db.NVarChar(191)
  courseTitle String   @db.NVarChar(191)
  score       Int
  user        User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, courseId])
}

{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Arranque local (SQL Server + :8080)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/start-local.js"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PORT": "8080"
      }
    },
    {
      "type": "msedge",
      "request": "launch",
      "name": "Abrir Edge :8080",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}/src"
    }
  ]
}

<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.2191419">
  <PropertyGroup>
    <!-- F5 ejecuta el servidor de desarrollo -->
    <StartupCommand>npm run dev</StartupCommand>
    <WorkingDirectory>$(MSBuildProjectDirectory)</WorkingDirectory>

    <!--
      Visual Studio suele fallar al correr "npm install" interno
      (PATH / Node). Lo desactivamos: instalá dependencias una vez
      en PowerShell fuera del build de VS.
    -->
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <BuildCommand></BuildCommand>
    <CleanCommand></CleanCommand>
  </PropertyGroup>
</Project>

# Desarrollo local
# Opción A — SQLite (simple, sin servidor):
DATABASE_URL="file:./dev.db"

# Opción B — SQL Server Express (tu máquina):
# DATABASE_URL="sqlserver://LARA-NB\\SQLEXPRESS02;database=Cusosventas;integratedSecurity=true;trustServerCertificate=true"
# En prisma/schema.prisma cambiá: provider = "sqlserver"

# Auth
AUTH_SECRET="dev-secret-change-me-in-production-32chars"
NEXTAUTH_URL="http://localhost:3000"

# App
APP_NAME="Academia Certifica"
APP_URL="http://localhost:3000"
UPLOAD_DIR="./uploads"

# Mercado Pago (opcional en local — sin token usa modo demo)
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""

# Admin inicial (seed)
ADMIN_EMAIL="admin@academia.local"
ADMIN_PASSWORD="Admin123!"
ADMIN_NAME="Administrador"

# =============================================================================
# Producción DonWeb (MySQL) — ejemplo:
# DATABASE_URL="mysql://USUARIO:PASSWORD@localhost:3306/NOMBRE_BD"
# En prisma/schema.prisma cambiá: provider = "mysql"
# =============================================================================

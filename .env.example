# =============================================================================
# Variables de entorno — Academia / Cursos
# Copiá este archivo a .env y completá los valores.
# =============================================================================

# --- Base de datos ---
# Desarrollo local (SQLite):
DATABASE_URL="file:./dev.db"

# Producción DonWeb (MySQL) — ejemplo:
# DATABASE_URL="mysql://USUARIO:PASSWORD@localhost:3306/NOMBRE_BD"
# Si la app corre fuera de DonWeb y se conecta remoto:
# DATABASE_URL="mysql://USUARIO:PASSWORD@IP_O_HOST_DONWEB:3306/NOMBRE_BD"
# En prisma/schema.prisma cambiá: provider = "mysql"

# --- Auth (NextAuth / Auth.js) ---
# Generá un secreto: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="https://tudominio.com"

# --- App ---
APP_NAME="Academia Certifica"
APP_URL="https://tudominio.com"
UPLOAD_DIR="./uploads"

# --- Mercado Pago Checkout Pro ---
# Obtené las credenciales en: https://www.mercadopago.com.ar/developers/panel
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
# Opcional: secreto para validar firmas de webhooks
MP_WEBHOOK_SECRET=""

# --- Usuario admin inicial (solo seed) ---
ADMIN_EMAIL="admin@tudominio.com"
ADMIN_PASSWORD="CambiarEstaClave!"
ADMIN_NAME="Administrador"
